{
  "name": "arcmrepo",
  "main": "src/index.js",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "ROADMAP_KV",
      "id": "<YOUR_KV_NAMESPACE_ID>"
    }
  ]
  // EDIT_TOKEN is a secret, not set here -- see README for how to add it
  // (either `npx wrangler secret put EDIT_TOKEN` locally, or via the
  // dashboard: your Worker -> Settings -> Variables and Secrets).
}
